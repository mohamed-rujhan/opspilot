# Copy to .env and fill in your own values. Never commit .env.
OPSPILOT_ENV=development
OPSPILOT_LOG_LEVEL=INFO

# LLM provider: "gemini" (default, free tier at https://aistudio.google.com) or "openai"
OPSPILOT_LLM_PROVIDER=gemini
OPSPILOT_LLM_MODEL=gemini-flash-latest
OPSPILOT_GEMINI_API_KEY=
OPSPILOT_OPENAI_API_KEY=

# Optional: prices in USD per 1M tokens, used for cost estimates in live evals
OPSPILOT_INPUT_COST_PER_MTOK=0
OPSPILOT_OUTPUT_COST_PER_MTOK=0

# Retrieval: "bm25" (default, no API calls) or "embeddings" (Gemini embeddings)
OPSPILOT_RETRIEVER=bm25

# Integrations
OPSPILOT_TICKET_API_URL=http://localhost:8001
OPSPILOT_HOLIDAY_COUNTRY=GB
